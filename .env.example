# .env.example
# Copy this file to .env.local and fill in the actual values from your team lead
# DO NOT commit .env.local to git

MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here

# SMTP (used by /api/contact)
# For Proton Mail: install Proton Mail Bridge and use its local SMTP settings (usually 127.0.0.1:1025),
# then copy the Bridge "username" and "password" here.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Optional: overrides the "from" header (defaults to SMTP_USER)
SMTP_FROM=

# Where contact form submissions should be delivered
CONTACT_TO=hello@chickenloop.com
